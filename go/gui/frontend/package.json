{
  "name": "@touhou-tagger/gui-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "check": "oxlint --type-aware --type-check",
    "build:dev": "pnpm run check && vite build --minify false --mode development",
    "build": "pnpm run check && vite build --mode production"
  },
  "dependencies": {
    "@primeuix/themes": "2.0.3",
    "@primevue/forms": "4.5.5",
    "@wailsio/runtime": "3.0.0-alpha.97",
    "lucide-vue-next": "0.577.0",
    "pinia": "3.0.4",
    "primevue": "4.5.5",
    "tailwind-merge": "3.6.0",
    "vue": "3.5.39",
    "vue-i18n": "11",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.9.3",
    "@vitejs/plugin-vue-jsx": "5.1.5",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "oxlint-tsgolint": "0.23.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "6.0.3",
    "vite": "8.1.4"
  },
  "packageManager": "pnpm@11.22.0"
}
